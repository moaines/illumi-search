    // ─── Index mapping ─────────────────────────────────────

    private function indexName(string $modelClass): string
    {
        if (isset($this->indexMap[$modelClass])) {
            return $this->indexMap[$modelClass];
        }

        $name = preg_replace('/[^a-z0-9_]/', '', strtolower(str_replace('\\', '_', $modelClass)));
        $this->indexMap[$modelClass] = $name;
        $this->saveIndexMap();

        return $name;
    }

